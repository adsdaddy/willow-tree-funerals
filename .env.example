# Railway runtime variables. Supply actual credentials through Railway Variables.
NODE_ENV=production
# Railway injects PORT. Leave it unset in the Railway dashboard unless required.
# PORT=3000
# Reference the actual MySQL service name, for example ${{MySQL.MYSQL_URL}}.
DATABASE_URL=
# Private Railway MySQL normally uses its private network, not public TLS.
# For a TLS-enabled target use true, certificate verification remains enabled.
DATABASE_SSL=false
RESEND_API_KEY=
# Verify notify.willowtreefunerals.com.au in Resend before setting this sender.
EMAIL_FROM=Willow Tree Funerals Website <website@notify.willowtreefunerals.com.au>
EMAIL_TO=director@willowtreefunerals.com.au
# New independently generated key. Coordinate rotation with babylovegrowth.ai.
BLOG_API_KEY=
# After the public R2 custom domain is Active and every object is verified.
MEDIA_PUBLIC_BASE_URL=https://media.willowtreefunerals.com.au
# Offline verification only, outside repository and build context:
# MEDIA_LOCAL_DIR=/absolute/path/to/recovered/media

# Build-time public identifiers, declared ARG in Dockerfile.
VITE_GA4_MEASUREMENT_ID=G-ZPSZ3KQRF4
VITE_META_PIXEL_ID=

# Operator-only environment variables, NOT website/browser variables:
# TARGET_DATABASE_URL=<fresh empty Railway database URL>
# R2_ACCOUNT_ID=<Cloudflare account ID>
# R2_ACCESS_KEY_ID=<bucket-scoped object access key>
# R2_SECRET_ACCESS_KEY=<bucket-scoped secret>
# R2_BUCKET=willow-tree-funerals-media
